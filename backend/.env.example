# Copier ce fichier en .env pour le développement local.

PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=c3digital
DATABASE_PASSWORD=c3digital
DATABASE_NAME=c3_digital
# Ne jamais mettre "true" en production : le schéma est géré par les migrations.
DATABASE_SYNCHRONIZE=false
DATABASE_SSL=false

# Authentification JWT — TOUJOURS définir un secret fort et unique en production.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=12h

# Secret partagé attendu sur POST /subscriptions/webhooks/:provider — à remplacer par la
# vérification de signature propre à chaque passerelle réelle une fois les comptes marchands
# connectés (voir backend/README.md, section "Abonnements & paiement").
SUBSCRIPTIONS_WEBHOOK_SECRET=dev-only-insecure-webhook-secret-change-me

# Clé API Anthropic (Claude) — les 3 fonctionnalités IA (PROMPT 8) sont désactivées
# proprement si cette valeur est vide (voir backend/README.md, section "Intelligence
# artificielle"). Jamais commitée réellement : garder cette valeur vide en exemple.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
