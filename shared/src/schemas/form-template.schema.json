{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c3-digital.local/schemas/form-template.schema.json",
  "title": "FormTemplate",
  "description": "Modèle (template) d'un formulaire dynamique IGE : C2, C3, C3B, C3M ou C3_DAS. Reflète shared/src/types/form-template.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "code",
    "name",
    "version",
    "header",
    "fieldGroups",
    "sections",
    "conversionTable",
    "synthesis",
    "signatures",
    "isActive"
  ],
  "properties": {
    "id": { "type": "string" },
    "code": {
      "type": "string",
      "enum": ["C2", "C3", "C3B", "C3M", "C3_DAS"]
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version sémantique du template, ex: 1.0.0"
    },
    "description": { "type": "string" },
    "isActive": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/formHeaderField" }
        }
      }
    },
    "fieldGroups": {
      "type": "array",
      "items": { "$ref": "#/$defs/formFieldGroup" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/formSectionTemplate" }
    },
    "conversionTable": { "$ref": "#/$defs/conversionTable" },
    "synthesis": { "$ref": "#/$defs/synthesisTemplate" },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/signatureRoleTemplate" }
        }
      }
    }
  },
  "$defs": {
    "fieldOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "formHeaderField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "required", "common", "order"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["text", "textarea", "date", "number", "select"] },
        "required": { "type": "boolean" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/fieldOption" } },
        "common": {
          "type": "boolean",
          "description": "true si le champ appartient au socle commun (inspecteur, établissement, entité inspectée, année scolaire, numéro de rapport)"
        },
        "order": { "type": "integer", "minimum": 0 },
        "helpText": { "type": "string" }
      }
    },
    "formFieldGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/formHeaderField" }
        }
      }
    },
    "formCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "maxScore", "order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "maxScore": { "const": 4 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "customField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["text", "textarea", "date", "number", "select"] },
        "maxScore": { "const": 4 },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "adviceZoneTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "label", "required"],
      "properties": {
        "enabled": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "formSectionTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "title",
        "order",
        "criteria",
        "observationsLabel",
        "adviceZone",
        "custom_fields"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/formCriterion" }
        },
        "observationsLabel": { "type": "string", "minLength": 1 },
        "adviceZone": { "$ref": "#/$defs/adviceZoneTemplate" },
        "custom_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/customField" }
        }
      }
    },
    "conversionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 }
      }
    },
    "conversionTableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteriaCount", "ranges"],
      "properties": {
        "criteriaCount": { "type": "integer", "minimum": 1 },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/conversionRange" }
        }
      }
    },
    "conversionBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoreOn4", "minPercentage", "maxPercentage", "mention"],
      "properties": {
        "scoreOn4": { "type": "integer", "enum": [4, 3, 2, 1, 0] },
        "minPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "mention": { "type": "string", "minLength": 1 },
        "secondaryMention": { "type": "string" }
      }
    },
    "conversionTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "bands"],
      "properties": {
        "mode": { "type": "string", "enum": ["lookup_by_criteria_count", "percentage_only"] },
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/conversionBand" }
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/conversionTableRow" }
        }
      }
    },
    "synthesisRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionId", "label"],
      "properties": {
        "sectionId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "synthesisTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rows", "finalMentionLabel"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/synthesisRow" }
        },
        "conversionCriteriaCount": { "type": "integer", "minimum": 1 },
        "finalMentionLabel": { "type": "string", "minLength": 1 },
        "finalMentionHelpText": { "type": "string" },
        "sealLabel": { "type": "string" }
      }
    },
    "signatureRoleTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "label", "required", "order"],
      "properties": {
        "role": { "type": "string", "enum": ["enseignant", "chef_etablissement", "inspecteur"] },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
